# ==============================================================================
# ORIGINSEC ENVIRONMENT VARIABLES TEMPLATE
# Never commit real secrets or service account files to GitHub.
# ==============================================================================

# --- Client Firebase Configuration (Public browser identifiers only) ---
# Found in Firebase Console -> Project Settings -> Your Apps -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# --- Server-Side Firebase Token Verification (Optional override) ---
# Uses projectId from firebase-applet-config.json by default.
FIREBASE_PROJECT_ID=

# --- Optional Server-Side AI Explanation (Gemini) ---
# Obtain from Google AI Studio -> API Keys. Keep strictly server-side.
GEMINI_API_KEY=

# --- Optional Google PageSpeed Insights Integration (Lighthouse / Core Web Vitals) ---
# Obtain from Google Cloud Console -> APIs & Services -> PageSpeed Insights API.
PAGESPEED_API_KEY=

# --- Application Base URL ---
# Used in production for self-referential metadata and CORS/origin links.
APP_BASE_URL=http://localhost:3000
